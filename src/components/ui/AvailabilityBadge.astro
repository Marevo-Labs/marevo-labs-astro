---
// Availability Badge
// ------------
// Description: A pill with a pulsing dot announcing the current booking window.
// The range is rendered at build time as a fallback, then refreshed in the browser
// so it stays accurate between deploys.

import { getAvailabilityRange } from "@/lib/availability"

const range = getAvailabilityRange()
---

<div
  class="font-gotham tracking-wide uppercase inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-border bg-muted text-sm"
>
  <span class="relative flex size-3">
    <span
      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-light-emerald opacity-75"
    ></span>
    <span class="relative inline-flex rounded-full size-3 bg-light-emerald"
    ></span>
  </span>
  <span
    >Now accepting new projects for <span data-availability-range>{range}</span
    ></span
  >
</div>

<script>
  import { getAvailabilityRange } from "@/lib/availability"

  // astro:page-load rather than a bare call: the site uses <ClientRouter />, and
  // view transitions swap in the page's build-time markup without re-running scripts.
  document.addEventListener("astro:page-load", () => {
    const range = getAvailabilityRange()
    document
      .querySelectorAll("[data-availability-range]")
      .forEach((el) => (el.textContent = range))
  })
</script>
